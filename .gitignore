# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Packaged apps. Gradle already writes these under build/, but a stray copy
# anywhere else is a ~85MB binary that must not reach the repo.
*.apk
*.aab
*.aar

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# generated by scripts/import-probe.js
.import-probe.jsx
.import-probe-entry.js

# Environment / secrets. Nothing in this project reads a .env today, but the
# RedX proxy base and the SMS gateway are both slated to move server-side and
# will land here first - see MIGRATION.md "Known issues".
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision

# NOTE: android/app/google-services.json IS committed on purpose. It holds only
# public client identifiers - Firebase access is gated by security rules, not by
# keeping this file secret. A real release keystore, by contrast, is covered by
# the *.keystore rule above.

# Editors
.vscode/
*.swp
*~

# Merge / patch leftovers
*.orig
*.rej

# Scratch output from branding/generate-icons.py. The generated icons belong in
# android/app/src/main/res, not here - see branding/README.md.
branding/generated/
res_out/
